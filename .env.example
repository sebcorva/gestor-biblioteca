# Copiar a .env y completar. El .env y la carpeta wallet/ estan en .gitignore: nunca se suben a git.
# La wallet de Oracle se descomprime en ./wallet (tnsnames.ora debe quedar en ./wallet/tnsnames.ora).
# <alias> es el nombre del servicio en wallet/tnsnames.ora (por ejemplo midb_high).

# Sirve para ./mvnw spring-boot:run y para docker compose (en el contenedor ./wallet = /app/wallet)
DB_URL=jdbc:oracle:thin:@<alias>?TNS_ADMIN=./wallet
DB_USERNAME=FORO_APP
DB_PASSWORD=<contrasena>

# Secreto Base64 para validar los JWT. Debe ser IDENTICO al JWT_SECRET de auth-users.
JWT_SECRET=<secreto-base64>
