{
  "info": {
    "name": "gestor-biblioteca (foro)",
    "description": "Microservicio de foro: publicaciones y comentarios (puerto 8080). Requiere auth-users en el 8081 para el login. Ejecutar las carpetas en orden (o Run collection). Los tokens e ids se guardan solos en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Login (auth-users)",
      "item": [
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUsuarios}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@biblioteca.cl\",\n  \"password\": \"Admin2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
